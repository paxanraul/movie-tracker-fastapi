# Базовый образ — Python 3.12 в облегчённой версии (slim = меньше размер, только необходимое)
FROM python:3.12-slim

# Устанавливаем рабочую папку внутри контейнера (все команды ниже выполняются в /app)
WORKDIR /app

# Копируем только файл зависимостей — чтобы Docker кэшировал этот слой отдельно.
# Если код изменился, но requirements.txt — нет, pip install заново не запустится
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код бэкенда и фронтенда в контейнер
COPY back ./back
COPY front ./front

# Создаём группу и пользователя без пароля и без домашней папки
RUN groupadd --system app && useradd --system --gid app appuser

# Передаём владение рабочей папкой новому юзеру
# (нужно, потому что файлы скопированы под root и appuser не может их читать/писать)
RUN chown -R appuser:app /app

# Все следующие команды (включая CMD) выполнятся от имени appuser
USER appuser

# Переходим в папку бэкенда — отсюда будет запускаться uvicorn
WORKDIR /app/back

# Говорим Docker, что приложение слушает порт 8000 (документация, не открывает порт сам по себе)
EXPOSE 8000

# Команда запуска приложения. --host 0.0.0.0 — принимать подключения извне контейнера
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
